# Microsoft Bot Framework credentials (from Azure Bot resource > Configuration)
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=
# MultiTenant (default) | SingleTenant | UserAssignedMSI
MICROSOFT_APP_TYPE=MultiTenant
# Required only when MICROSOFT_APP_TYPE=SingleTenant
MICROSOFT_APP_TENANTID=

# Google Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Optional overrides
GEMINI_MODEL=gemini-2.5-flash
PORT=3978

# Read-only Facebook page token (pages_read_user_content) so the bot can answer
# about the page's latest posts. NOT the Messenger token. Leave empty to disable.
# Set in Azure with ./tools/set-page-feed-token.sh
FACEBOOK_PAGE_ID=728353493701593
FACEBOOK_PAGE_TOKEN=
